# Virtual environments — never commit these. A committed venv is thousands of
# files of somebody else's compiled code, and it is what a reader sees first.
.venv/
venv/
myvenv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Cached API responses. Regenerated by scripts/fetch_data.py; the processed
# datasets under data/processed/ ARE committed, because they are the evidence
# the published index rests on.
data/raw/*.json
!data/raw/.gitkeep

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local working notes — kept out of the published repo
CLAUDE.md
